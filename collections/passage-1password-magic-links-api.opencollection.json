{
  "opencollection": "1.0.0",
  "info": {
    "name": "Passage by 1Password Management Devices Magic Links API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Magic Links",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a magic link",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.passage.id/v1/apps/:app_id/magic-links",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "The Passage application ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a magic link for login or identifier verification. Supply email or phone; set send=true (with channel) to have Passage deliver it, otherwise the embedded link is returned for your own delivery. If the user does not exist they are created first."
        }
      ]
    }
  ],
  "bundled": true
}