          "request": {
            "name": "Create a magic link",
            "description": {
              "content": "Creates a magic link for login or identifier verification. Supply email or phone; set send=true (with channel) to have Passage deliver it, otherwise the embedded link is returned for your own delivery. If the user does not exist they are created first.",
              "type": "text/plain"
            },
            "url": {
