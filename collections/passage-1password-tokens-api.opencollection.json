{
  "opencollection": "1.0.0",
  "info": {
    "name": "Passage by 1Password Management Devices Tokens API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Revoke a user's refresh tokens",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.passage.id/v1/apps/:app_id/users/:user_id/tokens",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "The Passage application ID."
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The Passage user ID."
              }
            ]
          },
          "docs": "Revokes all of a user's active refresh tokens, signing them out across devices."
        }
      ]
    }
  ],
  "bundled": true
}